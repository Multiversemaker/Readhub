<main id="mainContent" class="content shifted-collapsed p-0">

  <div class="d-flex justify-content-between align-items-center px-4 py-3 border-bottom bg-white">
    <h5 class="mb-0 fw-semibold"><%= title %></h5>

    <div class="d-flex gap-2">
      <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm">
        ← Kembali
      </a>
      <a href="<%= pdfUrl %>" class="btn btn-primary btn-sm" download>
        Download
      </a>
    </div>
  </div>

  <div style="height: calc(100vh - 64px);" oncontextmenu="return false">
    <iframe
      src="<%= pdfUrl %>#toolbar=0"
      width="100%"
      height="100%"
      style="border:none;">
    </iframe>
  </div>

</main>