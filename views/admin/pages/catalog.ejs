<main id="mainContent" class="content shifted-collapsed p-4">

  <div class="header-section">
    <div class="header-overlay">
      <h1 class="heading">Katalog</h1>
    </div>
  </div>

  <div class="action-section d-flex justify-content-between align-items-center mt-4">
    <input type="text" class="form-control search-input" placeholder="Cari buku berdasarkan judul..." style="width: 300px;" />

    <a href="/admin/books/add-book" class="btn">
      + Tambah Buku Baru
    </a>
  </div>

  <div class="table-section mt-4">
    <div class="table-responsive custom-table-wrapper">
      <table class="table custom-table">
        <thead>
          <tr>
            <th>Judul Buku</th>
            <th>Penulis</th>
            <th>Tipe</th>
            <th>Stok</th>
            <th>Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% books.forEach(book => { %>
          <tr>
            <td><%= book.judul %></td>
            <td><%= book.penulis %></td>
            <td><%= book.tipe?.tipe %></td>
            <td><%= book.stok_tersedia || "N/A" %></td>
            <td>
              <div class="d-flex flex-wrap gap-2">

                <!-- Edit -->
                <a href="/admin/books/edit-book/<%= book.id_buku %>" class="btn btn-sm action-btn">
                  <i class="bi bi-pencil-square"></i>
                </a>

                <!-- Hapus -->
                <form action="/admin/books/<%= book.id_buku %>?_method=DELETE" method="POST" onsubmit="return confirm('Yakin ingin menghapus buku ini?')">
                  <button type="submit" class="btn btn-sm action-btn">
                    <i class="bi bi-trash"></i>
                  </button>
                </form>

                <% if (
      book.tipe?.tipe?.toLowerCase() === "digital" ||
      book.type === "application/pdf"
    ) { %>

                <!-- Preview -->
                <a href="/admin/books/view/<%= book.id_buku %>" class="btn btn-sm action-btn">
                  <i class="bi bi-eye"></i>
                </a>

                <!-- Download -->
                <a href="/admin/books/download/<%= book.id_buku %>" class="btn btn-sm action-btn">
                  <i class="bi bi-download"></i>
                </a>

                <!-- Open Local -->
                <a href="/admin/books/open-local/<%= book.id_buku %>" class="btn btn-sm action-btn">
                  <i class="bi bi-box-arrow-up-right"></i>
                </a>

                <% } %>
              </div>
            </td>

          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

</main>