<main id="mainContent" class="content shifted-collapsed p-4">

  <div class="header-section mb-4">
    <div class="header-overlay">
      <h1 class="heading">Tambah Buku</h1>
    </div>
  </div>

  <div class="card p-4 shadow-sm">
    <form action="/admin/books" method="POST" enctype="multipart/form-data">

      <div class="row">
        <!-- COVER -->
        <div class="col-md-3">
          <img
            src="/images/default-book.png"
            class="img-fluid rounded shadow-sm mb-3"
            alt="Cover Buku"
          >
          <input
            type="file"
            name="cover_image"
            class="form-control"
            accept="image/*"
          >
        </div>

        <!-- INPUT -->
        <div class="col-md-9">
          <div class="row g-3">

            <div class="col-md-6">
              <label class="form-label">Judul Buku</label>
              <input type="text" name="judul" class="form-control" required>
            </div>

            <div class="col-md-6">
              <label class="form-label">Penulis</label>
              <input type="text" name="penulis" class="form-control">
            </div>

            <div class="col-md-6">
              <label class="form-label">Penerbit</label>
              <input type="text" name="penerbit" class="form-control">
            </div>

            <div class="col-md-6">
              <label class="form-label">Tahun Terbit</label>
              <input type="number" name="tahun_terbit" class="form-control">
            </div>

            <div class="col-md-6">
              <label class="form-label">Kategori</label>
              <select name="kategori" class="form-select" required>
                <option value="" disabled selected>-- Pilih Kategori --</option>
                <% kategoriList.forEach(k => { %>
                  <option value="<%= k.idkategori %>"><%= k.kategori %></option>
                <% }) %>
              </select>
            </div>

            <div class="col-md-6">
              <label class="form-label">Tipe Buku</label>
              <select name="tipe" id="tipeSelect" class="form-select" required>
                <option value="fisik">Buku Fisik</option>
                <option value="digital">Buku Digital</option>
              </select>
            </div>

            <!-- STOK (WAJIB, SATU SAJA) -->
            <div class="col-md-6">
              <label class="form-label">
                Stok <small class="text-muted">(fisik = jumlah, digital = kuota)</small>
              </label>
              <input
                type="number"
                name="stok"
                class="form-control"
                min="1"
                required
              >
            </div>

            <!-- LOKASI RAK (FISIK) -->
            <div class="col-md-6" id="rakGroup">
              <label class="form-label">Lokasi Rak</label>
              <input type="text" name="lokasi_rak" class="form-control">
            </div>

            <!-- FILE DIGITAL -->
            <div class="col-md-6 d-none" id="digitalFileGroup">
              <label class="form-label">File Buku (PDF)</label>
              <input type="file" name="file_buku" class="form-control" accept=".pdf">
            </div>

            <div class="col-md-12">
              <label class="form-label">Deskripsi</label>
              <textarea name="deskripsi" class="form-control" rows="3"></textarea>
            </div>

          </div>
        </div>
      </div>

      <div class="d-flex justify-content-end gap-2 mt-4">
        <a href="/admin/books" class="btn">Batal</a>
        <button type="submit" class="btn">Simpan Buku</button>
      </div>

    </form>
  </div>
</main>