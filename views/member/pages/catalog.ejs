<main id="mainContent" class="content">

  <!-- HERO -->
  <section class="hero-section">
    <div class="overlay"></div>
    <div class="container text-center position-relative">
      <h1>Catalog</h1>
    </div>
  </section>

  <!-- CONTENT -->
  <section class="page-content container">

    <div class="d-flex justify-content-between align-items-center mb-4">
      <h3>Berikut Buku – Buku Tersedia</h3>

      <button class="btn btn-outline-dark btn-sm">
        <i class="bi bi-funnel"></i> Filter
      </button>
    </div>

    <!-- GRID BUKU -->
    <div class="row g-4">
      <% books.forEach(book => { %>
      <div class="col-6 col-md-4 col-lg-3 col-xl-2">
        <a href="/member/catalog/<%= book.id_buku %>" class="book-card">

          <% if (book.cover_image) { %>
          <img src="<%= book.cover_image %>" alt="<%= book.judul %>">
          <% } else { %>
          <div class="no-cover">
            <span>No Photo</span>
          </div>
          <% } %>

        </a>

      </div>
      <% }) %>
    </div>

    <nav class="d-flex justify-content-center mt-5">
      <ul class="pagination pagination-sm m-0">

        <% if (currentPage > 1) { %>
        <li class="page-item">
          <a class="page-link" href="/member/catalog?page=<%= currentPage - 1 %>">&laquo;</a>
        </li>
        <% } %>

        <% for (let i = 1; i <= totalPages; i++) { %>

        <% if (
        i === 1 ||
        i === totalPages ||
        (i >= currentPage - 1 && i <= currentPage + 1)
      ) { %>

        <li class="page-item <%= i === currentPage ? 'active' : '' %>">
          <a class="page-link" href="/member/catalog?page=<%= i %>"><%= i %></a>
        </li>

        <% } else if (i === currentPage - 2 || i === currentPage + 2) { %>

        <li class="page-item disabled">
          <span class="page-link">...</span>
        </li>

        <% } %>

        <% } %>

        <% if (currentPage < totalPages) { %>
        <li class="page-item">
          <a class="page-link" href="/catalog?page=<%= currentPage + 1 %>">&raquo;</a>
        </li>
        <% } %>

      </ul>
    </nav>


  </section>
</main>