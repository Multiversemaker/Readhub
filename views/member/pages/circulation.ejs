<div class="container mt-5" style="padding-top: 80px;">
  <div class="row mb-4">
    <div class="col-md-12 text-center">
      <h2 class="fw-bold">Status Peminjaman Saya</h2>
      <p class="text-muted">Pantau buku yang sedang kamu pinjam dan riwayat pengembalian.</p>
    </div>
  </div>

  <div class="card shadow-sm border-0">
    <div class="card-body">

      <% if (loansFisik.length === 0 && loansDigital.length === 0) { %>
      <div class="text-center py-5">
        <h4 class="text-muted">Belum ada riwayat peminjaman.</h4>
        <a href="/member/catalog" class="btn btn-primary mt-3">Cari Buku Sekarang</a>
      </div>
      <% } else { %>

      <!-- ================= BUKU FISIK ================= -->
      <% if (loansFisik.length > 0) { %>
      <h5 class="fw-bold mb-3">📚 Peminjaman Buku Fisik</h5>

      <div class="table-responsive mb-5">
        <table class="table table-hover align-middle">
          <thead class="table-light">
            <tr>
              <th>Buku</th>
              <th>Tanggal Pinjam</th>
              <th>Jatuh Tempo</th>
              <th>Status</th>
              <th>Keterangan</th>
            </tr>
          </thead>
          <tbody>
            <% loansFisik.forEach(loan => { %>
            <%
                    const today = new Date();
                    const dueDate = new Date(loan.tanggal_jatuh_tempo);
                    const isLate = today > dueDate && !loan.tanggal_kembali;
                  %>

            <tr>
              <td>
                <div class="d-flex align-items-center">
                  <% if (loan.buku?.cover_image) { %>
                  <img src="<%= loan.buku.cover_image %>" alt="Cover" style="width:40px;height:60px;object-fit:cover;margin-right:10px" class="rounded">
                  <% } %>
                  <span class="fw-bold"><%= loan.buku?.judul || "Buku Dihapus" %></span>
                </div>
              </td>

              <td><%= new Date(loan.tanggal_pinjam).toLocaleDateString("id-ID") %></td>

              <td class="<%= isLate ? 'text-danger fw-bold' : '' %>">
                <%= dueDate.toLocaleDateString("id-ID") %>
                <% if (isLate) { %><br><small>Terlambat!</small><% } %>
              </td>

              <td>
                <% if (!loan.tanggal_kembali) { %>
                <span class="badge bg-warning text-dark">Sedang Dipinjam</span>
                <% } else { %>
                <span class="badge bg-success">Sudah Kembali</span>
                <% } %>
              </td>

              <td>
                <% if (loan.tanggal_kembali) { %>
                Dikembalikan:
                <%= new Date(loan.tanggal_kembali).toLocaleDateString("id-ID") %>
                <% } else { %>
                -
                <% } %>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>

      <!-- ================= BUKU DIGITAL ================= -->
      <% if (loansDigital.length > 0) { %>
      <h5 class="fw-bold mb-3">💻 Peminjaman Buku Digital</h5>

      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead class="table-light">
            <tr>
              <th>Buku</th>
              <th>Tanggal Akses</th>
              <th>Kedaluwarsa</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% loansDigital.forEach(loan => { %>
            <tr>
              <td>
                <div class="d-flex align-items-center">
                  <% if (loan.buku?.cover_image) { %>
                  <img src="<%= loan.buku.cover_image %>" alt="Cover" style="width:40px;height:60px;object-fit:cover;margin-right:10px" class="rounded">
                  <% } %>
                  <span class="fw-bold"><%= loan.buku?.judul || "Buku Dihapus" %></span>
                </div>
              </td>

              <td>
                <%= loan.tanggal_akses
                        ? new Date(loan.tanggal_akses).toLocaleDateString("id-ID")
                        : "-" %>
              </td>

              <td>
                <%= loan.tanggal_kadaluwarsa
                        ? new Date(loan.tanggal_kadaluwarsa).toLocaleDateString("id-ID")
                        : "-" %>
              </td>

              <td>
                <% if (loan.status === "aktif") { %>
                <span class="badge bg-success">Aktif</span>
                <% } else { %>
                <span class="badge bg-secondary">Kedaluwarsa</span>
                <% } %>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>

      <% } %>

    </div>
  </div>
</div>